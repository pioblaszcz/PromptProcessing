@PromptProcessing.Api_HostAddress = http://localhost:5158

POST {{PromptProcessing.Api_HostAddress}}/api/prompt-jobs
Content-Type: application/json

{
  "prompts": [
    "Summarize the benefits of asynchronous processing.",
    "Write three interview questions for a C# developer."
  ]
}

###

GET {{PromptProcessing.Api_HostAddress}}/api/prompt-jobs?take=20
Accept: application/json

###

GET {{PromptProcessing.Api_HostAddress}}/api/prompt-jobs/status?ids=00000000-0000-0000-0000-000000000000
Accept: application/json

